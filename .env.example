# Copy to .env and fill in.
PORT=3000
# 127.0.0.1 when nginx is in front (recommended), 0.0.0.0 to reach it directly by IP
HOST=127.0.0.1

# Admin password. Recommended: generate a hash
#   npm run hash-password -- "a long passphrase"
# and paste the printed line here:
ADMIN_PASSWORD_HASH=
# (Quick alternative for local testing only)
# ADMIN_PASSWORD=change-me

# Random string, 32+ chars. Keeps people logged in across restarts.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# How long a login lasts (hours)
SESSION_HOURS=12

# Set when the app runs under a sub-path, e.g. https://samansamnuek.com/proposals
BASE_PATH=

# Behind nginx/Cloudflare: 1 so secure cookies and login throttling see the real client
TRUST_PROXY=1

# Where proposals are stored (JSON files). Back this folder up.
DATA_DIR=./data
